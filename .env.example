# Copy to .env and fill in. Never commit .env.

# Boson AI (https://docs.boson.ai/set-up-your-account)
BOSON_API_KEY=
BOSON_BASE_URL=https://api.boson.ai/v1

# Where movies live (relative to repo root)
DATA_DIR=data/movies

# Offline preprocessing LLM: "ollama" (free, local) or "higgs_text" (Higgs Realtime text mode, uses Boson credit)
LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
